# ============================================================
# BGSBU Interacts — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# ==================== APPLICATION ====================
SECRET_KEY=change-me-to-a-long-random-secret-key
DEBUG=False
FLASK_ENV=production

# ==================== DATABASE ====================
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=bgsbu_interacts
MYSQL_PORT=3306

# ==================== EMAIL (Brevo / SMTP) ====================
# Choose one method: Brevo API OR SMTP

# Option A: Brevo API
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM=your_verified_sender@example.com
EMAIL_FROM_NAME=BGSBU Interacts

# Option B: SMTP (Gmail app password or other)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here

# ==================== ADMIN ====================
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-to-strong-password

# ==================== UPLOADS ====================
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
